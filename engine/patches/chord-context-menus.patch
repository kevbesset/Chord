Chord: right click on a page shows its menu in Chord's windows, which have no Views widget.
--- a/chrome/browser/ui/cocoa/renderer_context_menu/render_view_context_menu_mac_cocoa.mm
+++ b/chrome/browser/ui/cocoa/renderer_context_menu/render_view_context_menu_mac_cocoa.mm
@@ -13,6 +13,8 @@
 #import "base/message_loop/message_pump_apple.h"
 #include "base/strings/sys_string_conversions.h"
 #include "base/task/current_thread.h"
+#include "chord/browser/chord_context_menu.h"  // nogncheck
+#include "chord/browser/chord_hooks.h"  // nogncheck
 #include "chrome/browser/headless/headless_mode_util.h"
