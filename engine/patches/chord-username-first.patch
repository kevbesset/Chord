+bool IsLoneEmailForm(const autofill::FormData& form) {
+  const autofill::FormFieldData* email = nullptr;
+  for (const autofill::FormFieldData& field : form.fields()) {
+    if (!field.is_focusable() || !field.IsTextInputElement()) {
+      continue;
+    }
+    if (email || field.IsPasswordInputElement() ||
+        base::ToLowerASCII(field.autocomplete_attribute()).find("email") ==
+            std::string::npos) {
+      return false;
+    }
+    email = &field;
+  }
+  return email;
+}
