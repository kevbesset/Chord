Chord: the password manager's "Save password?" asks through ChordUI in Chord's windows.
--- a/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
+++ b/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
@@ -20,6 +20,9 @@
 #include "base/task/sequenced_task_runner.h"
 #include "base/timer/timer.h"
 #include "build/build_config.h"
+#if BUILDFLAG(IS_MAC)
+#include "chord/browser/chord_password_prompt.h"  // nogncheck
+#endif
 #include "chrome/app/chrome_command_ids.h"
 #include "chrome/browser/actor/actor_keyed_service.h"
 #include "chrome/browser/feature_engagement/tracker_factory.h"
@@ -1534,6 +1537,12 @@
 }
 
 void ManagePasswordsUIController::ShowBubble() {
+#if BUILDFLAG(IS_MAC)
+  // Chord's windows ask through ChordUI (Chrome's bubble hangs from its toolbar).
+  if (chord::ShowPasswordBubble(web_contents())) {
+    return;
+  }
+#endif
   if (TabDialogs* tab_dialogs = TabDialogs::FromWebContents(web_contents())) {
     tab_dialogs->ShowManagePasswordsBubble(user_action_);
   }
@@ -1541,6 +1550,9 @@
 
 void ManagePasswordsUIController::HideBubble(bool initiated_by_bubble_manager) {
   is_mouse_hovered_ = false;
+#if BUILDFLAG(IS_MAC)
+  chord::HidePasswordBubble(web_contents());
+#endif
   if (TabDialogs* tab_dialogs = TabDialogs::FromWebContents(web_contents())) {
     tab_dialogs->HideManagePasswordsBubble();
   }
