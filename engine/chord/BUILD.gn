# The ids of Chromium's branded strings, for chord_browser_main_extra_parts.mm, which
# names Chord where they name Chromium.
action("branded_string_ids") {
  script = "tools/branded_string_ids.py"
  inputs = [
    "$root_gen_dir/chrome/grit/branded_strings.h",
    "$root_gen_dir/components/strings/grit/components_branded_strings.h",
  ]
  outputs = [ "$target_gen_dir/branded_string_ids.inc" ]
  args = rebase_path(outputs, root_build_dir) + rebase_path(inputs, root_build_dir)
  deps = [
    "//chrome/app:branded_strings",
    "//components/strings:components_branded_strings",
  ]
}
