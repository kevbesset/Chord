    "Chord found Arc on this Mac. Your Spaces, favorites and pinned tabs can come over as they are. Arc is left unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord ha encontrado Arc en este Mac. Tus Spaces, favoritos y pestañas fijadas pueden venir tal cual. Arc no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord a trouvé Arc sur ce Mac. Vos Spaces, vos favoris et vos onglets épinglés peuvent être repris tels quels. Arc n'est pas modifié."
          }
        }
      }
    },
