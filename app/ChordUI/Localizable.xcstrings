    "macOS didn't give access to %@'s key: logins and passwords stayed in %@. %lld history pages imported.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no dio acceso a la clave de %@: las sesiones y contraseñas se quedaron en %@. %lld páginas del historial importadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas donné accès à la clé de %@ : connexions et mots de passe sont restés dans %@. %lld pages d'historique importées."
          }
        }
      }
    },
    "macOS didn't give access to Arc's key: logins and passwords stayed in Arc. %lld history pages imported.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no ha dado acceso a la clave de Arc: los inicios de sesión y las contraseñas se han quedado en Arc. %lld páginas del historial importadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas donné accès à la clé d'Arc : les connexions et les mots de passe sont restés dans Arc. %lld pages d'historique reprises."
          }
        }
      }
    },
    "macOS keeps Safari's bookmarks and history from other apps. Give Chord Full Disk Access in System Settings › Privacy & Security, then import again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS protege los marcadores y el historial de Safari de otras apps. Da a Chord acceso total al disco en Ajustes del Sistema › Privacidad y seguridad, y vuelve a importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS protège les favoris et l'historique de Safari des autres apps. Donnez à Chord l'accès complet au disque dans Réglages Système › Confidentialité et sécurité, puis importez à nouveau."
          }
        }
      }
    },
