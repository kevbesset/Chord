    "Tabs left unused this long go to the archive (⌥⌘A), like Arc. Pinned tabs and favorites stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas sin usar durante este tiempo van al archivo (⌥⌘A), como en Arc. Las fijadas y los favoritos se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets inutilisés depuis ce temps vont aux archives (⌥⌘A), comme dans Arc. Les onglets épinglés et les favoris restent."
          }
        }
      }
    },
    "Teal": {
      "localizations": {
        "es": {
