    },
    "Arc's sidebar, Spaces and command bar, native on the Mac. Three things, and you're home.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra lateral, los Spaces y la barra de comandos de Arc, nativos en el Mac. Tres cosas, y estás en casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre latérale, les Spaces et la barre de commande d'Arc, natifs sur le Mac. Trois choses, et vous êtes chez vous."
          }
        }
      }
    },
