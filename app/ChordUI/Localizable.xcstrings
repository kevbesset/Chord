    "Each profile of the browser becomes a Space, with its bookmarks bar as pinned tabs. Logins, passwords, history and extensions come into that Space's profile. The browser is left unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil del navegador se convierte en un Space, con su barra de marcadores como pestañas fijadas. Sesiones, contraseñas, historial y extensiones llegan al perfil de ese Space. El navegador no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil du navigateur devient un Space, avec sa barre de favoris en onglets épinglés. Connexions, mots de passe, historique et extensions arrivent dans le profil de ce Space. Le navigateur reste inchangé."
          }
        }
      }
    },
