    "Spaces on the same profile share their favorites and their session (logins, cookies, extensions), like Arc's profiles.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Spaces de un mismo perfil comparten sus favoritos y su sesión (inicios de sesión, cookies, extensiones), como los perfiles de Arc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Spaces d'un même profil partagent leurs favoris et leur session (connexions, cookies, extensions), comme les profils d'Arc."
          }
        }
      }
    },
    "Spaces on the same profile share their favorites and their session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Spaces de un mismo perfil comparten sus favoritos y su sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Spaces d'un même profil partagent leurs favoris et leur session."
          }
        }
      }
    },
    "Spaces, favorites and pinned tabs, as they are.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces, favoritos y pestañas fijadas, tal cual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaces, favoris et onglets épinglés, tels quels."
          }
        }
      }
    },
    "Spaces, tabs, favorites, logins, passwords, history, extensions and settings are deleted, and Chord restarts as on its first launch. Your downloaded files stay. This cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan los Spaces, pestañas, favoritos, sesiones, contraseñas, historial, extensiones y ajustes, y Chord se reinicia como en su primer uso. Tus archivos descargados se conservan. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Spaces, onglets, favoris, connexions, mots de passe, historique, extensions et réglages sont supprimés, et Chord redémarre comme au premier lancement. Vos fichiers téléchargés restent. Cette action est irréversible."
          }
        }
      }
    },
