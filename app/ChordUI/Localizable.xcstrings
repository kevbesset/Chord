{
  "sourceLanguage": "en",
  "strings": {
    "%@ asks for a permission.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solicita un permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande une autorisation."
          }
        }
      }
    },
    "%@ imported": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ importado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ importé"
          }
        }
      }
    },
    "%@ is already used by “%@”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is already used by “%2$@”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya lo usa «%2$@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est déjà utilisé par « %2$@ »"
          }
        }
      }
    },
    "%@ is reserved for “%@”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is reserved for “%2$@”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está reservado para «%2$@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est réservé à « %2$@ »"
          }
        }
      }
    },
    "%@, tabs: %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, pestañas: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, onglets : %lld"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@"
          }
        }
      }
    },
    "%lld Spaces with %lld bookmarks as pinned tabs. A Space imported before is updated rather than duplicated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Spaces con %lld marcadores como pestañas fijadas. Un Space ya importado se actualiza en lugar de duplicarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Spaces avec %lld favoris en onglets épinglés. Un Space déjà importé est mis à jour plutôt que dupliqué."
          }
        }
      }
    },
    "%lld Spaces, %lld folders, %lld favorites, %lld tabs in all, with Arc's icons. A Space imported before is updated rather than duplicated.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld Spaces, %2$lld folders, %3$lld favorites, %4$lld tabs in all, with Arc's icons. A Space imported before is updated rather than duplicated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Spaces, %2$lld carpetas, %3$lld favoritos, %4$lld pestañas en total, con los iconos de Arc. Un Space ya importado se actualiza en lugar de duplicarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Spaces, %2$lld dossiers, %3$lld favoris, %4$lld onglets en tout, avec les icônes d'Arc. Un Space déjà importé est mis à jour plutôt que dupliqué."
          }
        }
      }
    },
    "%lld extensions installed from the Chrome Web Store.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld extensiones instaladas desde Chrome Web Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld extensions installées depuis le Chrome Web Store."
          }
        }
      }
    },
    "%lld history pages imported. Safari's passwords stay in iCloud Keychain, where Chord can't read them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld páginas del historial importadas. Las contraseñas de Safari se quedan en el llavero de iCloud, que Chord no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pages d'historique importées. Les mots de passe de Safari restent dans le trousseau iCloud, que Chord ne peut pas lire."
          }
        }
      }
    },
    "%lld login cookies, %lld passwords and %lld history pages imported, each into the profile of its Space. What was already in Chord is kept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cookies de sesión, %lld contraseñas y %lld páginas del historial importados, cada uno en el perfil de su Space. Lo que ya estaba en Chord se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cookies de connexion, %lld mots de passe et %lld pages d'historique importés, chacun dans le profil de son Space. Ce qui était déjà dans Chord est conservé."
          }
        }
      }
    },
    "%lld login cookies, %lld passwords and %lld history pages imported, each into the profile of its Spaces. What was already in Chord is kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld login cookies, %2$lld passwords and %3$lld history pages imported, each into the profile of its Spaces. What was already in Chord is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld cookies de sesión, %2$lld contraseñas y %3$lld páginas del historial importadas, cada una en el perfil de sus Spaces. Lo que ya estaba en Chord se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld cookies de connexion, %2$lld mots de passe et %3$lld pages d'historique repris, chacun dans le profil de ses Spaces. Ce qui était déjà dans Chord est gardé."
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sur %2$lld"
          }
        }
      }
    },
    "1 Space with %lld bookmarks as pinned tabs. A Space imported before is updated rather than duplicated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Space con %lld marcadores como pestañas fijadas. Un Space ya importado se actualiza en lugar de duplicarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Space avec %lld favoris en onglets épinglés. Un Space déjà importé est mis à jour plutôt que dupliqué."
          }
        }
      }
    },
    "1 extension installed from the Chrome Web Store.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 extensión instalada desde Chrome Web Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 extension installée depuis le Chrome Web Store."
          }
        }
      }
    },
    "A playing video carries on in a floating window when you switch tabs or Spaces, and goes back to its page when you return.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vídeo en reproducción sigue en una ventana flotante cuando cambias de pestaña o de Space, y vuelve a su página cuando regresas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vidéo en lecture continue dans une fenêtre flottante quand vous changez d'onglet ou de Space, et revient dans sa page à votre retour."
          }
        }
      }
    },
    "A report was saved in %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha guardado un informe en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapport a été enregistré dans %@."
          }
        }
